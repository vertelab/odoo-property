<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Sequences for key positions and keys

             The names are human-facing identifiers ("Key position 12"),
             so they come from sequences rather than from the database id.
             ============================================================ -->

        <record id="seq_property_key_position" model="ir.sequence">
            <field name="name">Property Key Position</field>
            <field name="code">property.key.position</field>
            <field name="prefix">KP/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_property_key" model="ir.sequence">
            <field name="name">Property Key</field>
            <field name="code">property.key</field>
            <field name="prefix">K/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
