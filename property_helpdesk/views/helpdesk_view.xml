<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="ticket_view_form" model="ir.ui.view">
      <field name="name">helpdesk.property.form</field>
      <field name="model">helpdesk.ticket</field>
      <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
      <field name="arch" type="xml">
        <field name="sequence" position="after">
          <field name="property_id" />
        </field>
      </field>
    </record>
    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
      <field name="name">helpdesk.property.search</field>
      <field name="model">helpdesk.ticket</field>
      <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search" />
      <field name="arch" type="xml">
        <field name="stage_id" position="after">
          <field name="property_id" />
        </field>
        <filter name="group_partner" position="after">
          <filter string="Property" name="group_property" domain="[]" context="{'group_by':'property_id'}" />
        </filter>
      </field>
    </record>
  </data>
</odoo>
