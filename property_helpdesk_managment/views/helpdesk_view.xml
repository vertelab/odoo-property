<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="ticket_view_form" model="ir.ui.view">
      <field name="name">helpdesk.property.form</field>
      <field name="model">helpdesk.ticket</field>
      <field name="inherit_id" ref="property_helpdesk.ticket_view_form" />
      <field name="arch" type="xml">
        <field name="property_id" position="after">
          <field name="maintenance_equipment_id" invisible="property_id == False" domain="[('property_id', '=', property_id)]"/>
          <field name="maintenance_team_id" required="1" invisible="maintenance_equipment_id == False"/>
          <field name="maintenance_request_id" invisible="maintenance_request_id == False"/>
          <button name="create_maintenance_request"
                  string="Create Maintenance Request"
                  type="object"
                  invisible="maintenance_request_id != False or property_id == False"/>
        </field>
      </field>
    </record>

    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
      <field name="name">helpdesk.property.search</field>
      <field name="model">helpdesk.ticket</field>
      <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search" />
      <field name="arch" type="xml">
        <field name="stage_id" position="after">
          <field name="property_id" />
        </field>
        <filter name="group_partner" position="after">
          <filter string="Equipment" name="group_equipment" domain="[]" context="{'group_by':'property_id'}" />
          <filter string="Maintenance Team" name="group_maintenance_team" domain="[]" context="{'group_by':'property_id'}" />
        </filter>
      </field>
    </record>
  </data>
</odoo>
