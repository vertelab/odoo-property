<odoo>
  <data>
       <record id="hr_equipment_request_view_form" model="ir.ui.view">
            <field name="name">hr_equipment_request_view_form</field>
            <field name="model">maintenance.request</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
            <field name="arch" type="xml">
                <field name="equipment_id" position="after">
                    <field name="helpdesk_ticket_id" invisible="helpdesk_ticket_id == False"/>
                </field>
            </field>
        </record>
  </data>
</odoo>
