<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <data>
        <!-- Adds the property link to the equipment form.

             The anchor is the second <group> inside the top-level <group>,
             not a field. hr_maintenance replaces `owner_user_id` wholesale
             with an xpath position="replace", so anchoring `after` on that
             field fails whenever hr_maintenance is loaded first:

                 Element '<field name="owner_user_id">' cannot be located
                 in parent view

             Both views sit at priority 16, so the winner is decided by
             module load order — which differs between databases. Anchoring
             on the group makes the result independent of that order.

             The xmlid is prefixed to avoid colliding with core's
             maintenance.hr_equipment_view_form, which this record
             previously reused. -->
        <record id="maintenance_equipment_view_form_property" model="ir.ui.view">
            <field name="name">maintenance.equipment.form.property</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group/group[2]" position="after">
                    <group string="Property">
                        <field name="property_id"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
