<odoo>
    <data>
        <record id="property_property_form_view" model="ir.ui.view">
            <field name="name">property.property.form.view</field>
            <field name="model">property.property</field>
            <field name="inherit_id" ref="property_mgmt.property_property_form_view"/>
            <field name="arch" type="xml">
      
                <field name="property_status" position="after">
                    <field name="agent_stakeholder_id" invisible="1"/>
                </field>

                <xpath expr="//sheet/div[@name='button_box']" position="inside">
                    <field name="website_url" invisible="1"/>
                    <field name="is_published" widget="website_redirect_button"/>
                </xpath>

                <xpath expr="//page[last()]" position="after">
                    <page string="Images">
                        <field name="property_image_ids">
                            <kanban>
                                <field name="id"/>
                                <field name="name"/>
                                <field name="image_1024"/>
                                <field name="description"/>
                                <templates>
                                    <t t-name="card">
                                        <div t-attf-class="oe_kanban_global_click">
                                            <div class="o_kanban_image">
                                                <field name="image_1024" widget="image" class="oe_avatar"/>
                                            </div>
                                            <div class="oe_kanban_details">
                                                <t class="o_kanban_record_title">
                                                    <strong>
                                                        <field name="name"/>
                                                    </strong>
                                                    <br/>
                                                    <field name="description"/>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                            <form>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="description"/>
                                        </group>
                                        <group>
                                            <field name="image_1024" string="" widget="image" class="oe_avatar"/>
                                        </group>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>


                </xpath>
            </field>
        </record>
    </data>
</odoo>
